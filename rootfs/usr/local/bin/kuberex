#!/bin/sh
# kuberex starts the Rex login server on the tailnet. The login server serves
# each caller from a Rex server running as the account its accounts file maps
# the caller to. kuberex runs as root and reads:
#
#   REX_LOGIN_SERVER_ACCOUNTS  the login server's accounts file
#   TS_SOCKET                  LocalAPI socket of a tailscaled on the tailnet
#   REX_TAILNET_PORT           tailnet port of the server (default 80)
#   KUBEREX_APT                optional directory of apt additions installed
#                              before the server starts: *.sources files,
#                              keyrings referenced by them, and a packages
#                              file of apt-get install arguments
#   KUBEREX_SECRETS            optional directory of Secrets per account, each
#                              at <account>/<secret>, copied where only that
#                              account can read them
#   KUBEREX_SERVICES           optional services file for kuberexctl services,
#                              whose services start beside the login server
#   KUBEREX_SHUTDOWN_ACCOUNTS  optional accounts, separated by spaces, that
#                              may shut the container down with
#                              kuberexctl shutdown
#   KUBEREX_KEEP_SERVERS       optional accounts, separated by spaces, whose
#                              Rex servers kuberexctl keep-servers keeps
#                              running without a session
#
# Every account the accounts file names, but root and "*", is created at start
# with zsh and a home in /home/<name>. /run/kuberex/ready marks the accounts,
# their Secrets and their temporary directories set up, for kuberexctl run in
# the account containers.
set -eu

# install_packages adds the sources and keyrings in directory $1 to apt and
# installs the packages its packages file lists. Nothing is kept: the root
# filesystem is the container's, so this runs at every start.
install_packages() {
  if [ -d "$1/sources" ]; then
    cp "$1"/sources/*.sources /etc/apt/sources.list.d/
  fi
  if [ -d "$1/keyrings" ]; then
    cp "$1"/keyrings/* /etc/apt/keyrings/
  fi
  if [ ! -s "$1/packages" ]; then
    return
  fi
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -q
  # shellcheck disable=SC2046 # one apt-get argument per word of the file
  apt-get install -y -q --no-install-recommends $(cat "$1/packages")
}

# create_account creates account $1 unless it exists. An existing home keeps
# its owner's uid; a new one takes the next free uid from 1000.
create_account() {
  home=/home/$1
  if getent passwd "$1" >/dev/null; then
    return
  fi
  if [ -d "$home" ]; then
    uid=$(stat -c %u "$home")
    groupadd --gid "$uid" "$1"
    useradd --uid "$uid" --gid "$uid" --home-dir "$home" --no-create-home \
      --shell /usr/bin/zsh "$1"
  else
    useradd --user-group --home-dir "$home" --no-create-home \
      --shell /usr/bin/zsh "$1"
    install -d -o "$1" -g "$1" -m 0700 "$home"
  fi
}

# create_accounts creates the accounts accounts file $1 names. Accounts with a
# home are created first, so a new account cannot take the uid an existing
# home belongs to.
create_accounts() {
  names=$(kuberexctl accounts "$1")
  for name in $names; do
    if [ -d "/home/$name" ]; then
      create_account "$name"
    fi
  done
  for name in $names; do
    create_account "$name"
  done
}

# prepare_run_kuberex makes /run/kuberex root's. It may be a volume shared
# with the account containers, which outlives this container: the marks of
# the container's last run are removed.
prepare_run_kuberex() {
  mkdir -p /run/kuberex
  chown 0:0 /run/kuberex
  chmod 0755 /run/kuberex
  rm -f /run/kuberex/ready /run/kuberex/shutdown
}

# install_secrets copies the keys of each Secret at $1/<account>/<secret> to
# /run/kuberex/secrets/<account>/<secret>, owned by the account with mode 0400
# in a directory only it can open.
install_secrets() {
  install -d -o 0 -g 0 -m 0711 /run/kuberex/secrets
  for src in "$1"/*/*/; do
    [ -d "$src" ] || continue
    secret=$(basename "$src")
    account=$(basename "$(dirname "$src")")
    dst=/run/kuberex/secrets/$account
    install -d -o "$account" -g "$account" -m 0700 "$dst" "$dst/$secret"
    for key in "$src"*; do
      if [ -f "$key" ]; then
        install -o "$account" -g "$account" -m 0400 "$key" "$dst/$secret/"
      fi
    done
  done
}

# create_tmpdirs makes /tmp/user/<uid>, pam_tmpdir's TMPDIR, for every account
# accounts file $1 names. The login server runs PAM with the account's uid,
# which can create neither that directory nor the root-owned /tmp/user that
# pam_tmpdir requires above it.
create_tmpdirs() {
  install -d -o 0 -g 0 -m 0711 /tmp/user
  for name in $(kuberexctl accounts "$1"); do
    install -d -o "$name" -g "$name" -m 0700 "/tmp/user/$(id -u "$name")"
  done
}

if [ "$(id -u)" != 0 ]; then
  echo "kuberex: the login server runs as root" >&2
  exit 1
fi
if [ -z "${REX_LOGIN_SERVER_ACCOUNTS:-}" ] || [ -z "${TS_SOCKET:-}" ]; then
  echo "kuberex: REX_LOGIN_SERVER_ACCOUNTS and TS_SOCKET are required" >&2
  exit 1
fi

if [ -n "${KUBEREX_APT:-}" ]; then
  install_packages "$KUBEREX_APT"
fi
create_accounts "$REX_LOGIN_SERVER_ACCOUNTS"
prepare_run_kuberex
if [ -n "${KUBEREX_SECRETS:-}" ]; then
  install_secrets "$KUBEREX_SECRETS"
fi
# Each account reaches its runtime directory below /run/rex.
chmod 0755 /run/rex
# The pod's fsGroup leaves an emptyDir /tmp at 2777 in that group, where any
# account may delete or replace another's files, /tmp/user included.
chown 0:0 /tmp
chmod 01777 /tmp
create_tmpdirs "$REX_LOGIN_SERVER_ACCOUNTS"
: >/run/kuberex/ready
# Kept servers start first, so that neither the services nor the login server
# start one that stops when empty. The keeper is a child of this shell, which
# stops it before stopping the servers.
keeper=
if [ -n "${KUBEREX_KEEP_SERVERS:-}" ]; then
  # shellcheck disable=SC2086 # one account per word
  kuberexctl keep-servers --once $KUBEREX_KEEP_SERVERS || true
  # shellcheck disable=SC2086
  kuberexctl keep-servers $KUBEREX_KEEP_SERVERS &
  keeper=$!
fi
# In a subshell that exits at once, so dumb-init rather than the login server
# reaps kuberexctl services and the account servers it starts.
if [ -n "${KUBEREX_SERVICES:-}" ]; then
  (kuberexctl services "$KUBEREX_SERVICES" &)
fi
rex login-server \
  --accounts "$REX_LOGIN_SERVER_ACCOUNTS" \
  --runtime-root /run/rex \
  --extra-listen "tailnet://:${REX_TAILNET_PORT:-80}" \
  --tailscaled-socket "$TS_SOCKET" \
  --log-format text &
login_server=$!
# dumb-init forwards a signal to this process too; the login server is the
# one it is meant for, SIGHUP reloading its accounts file.
trap 'kill -TERM "$login_server" 2>/dev/null' TERM
trap 'kill -INT "$login_server" 2>/dev/null' INT
trap 'kill -HUP "$login_server" 2>/dev/null' HUP

if [ -n "${KUBEREX_SHUTDOWN_ACCOUNTS:-}" ]; then
  (kuberexctl serve --login-server-pid "$login_server" --accounts "$KUBEREX_SHUTDOWN_ACCOUNTS" &)
fi

# wait returns early when a trapped signal arrives; the login server has
# exited only once it is gone.
status=0
while :; do
  status=0
  wait "$login_server" || status=$?
  if ! kill -0 "$login_server" 2>/dev/null; then
    break
  fi
done
echo "kuberex: the login server exited with status $status" >&2

# The account servers outlive the login server, which no longer starts new
# ones; stopping them lets each record a clean shutdown. The keeper goes
# first, or it would start them again.
if [ -n "$keeper" ]; then
  kill -TERM "$keeper" 2>/dev/null || true
  while kill -0 "$keeper" 2>/dev/null; do
    wait "$keeper" || true
  done
fi
kuberexctl stop-servers || true
if [ -e /run/kuberex/shutdown ]; then
  exit 0
fi
exit "$status"
