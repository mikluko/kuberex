#!/bin/sh
# kuberex starts the Rex login server on the tailnet. The login server serves
# each caller from a Rex server running as the account its accounts file maps
# the caller to. kuberex runs as root and reads:
#
#   REX_LOGIN_SERVER_ACCOUNTS  the login server's accounts file
#   TS_SOCKET                  LocalAPI socket of a tailscaled on the tailnet
#   REX_TAILNET_PORT           tailnet port of the server (default 80)
#   KUBEREX_APT                optional directory of apt additions installed
#                              before the server starts: *.sources files,
#                              keyrings referenced by them, and a packages
#                              file of apt-get install arguments
#   KUBEREX_SERVICES           optional services file for kuberex-services,
#                              whose services start beside the login server
#
# Every account the accounts file names, but root and "*", is created at start
# with zsh and a home in /home/<name>.
set -eu

# install_packages adds the sources and keyrings in directory $1 to apt and
# installs the packages its packages file lists. Nothing is kept: the root
# filesystem is the container's, so this runs at every start.
install_packages() {
  if [ -d "$1/sources" ]; then
    cp "$1"/sources/*.sources /etc/apt/sources.list.d/
  fi
  if [ -d "$1/keyrings" ]; then
    cp "$1"/keyrings/* /etc/apt/keyrings/
  fi
  if [ ! -s "$1/packages" ]; then
    return
  fi
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -q
  # shellcheck disable=SC2046 # one apt-get argument per word of the file
  apt-get install -y -q --no-install-recommends $(cat "$1/packages")
}

# create_account creates account $1 unless it exists. An existing home keeps
# its owner's uid; a new one takes the next free uid from 1000.
create_account() {
  home=/home/$1
  if getent passwd "$1" >/dev/null; then
    return
  fi
  if [ -d "$home" ]; then
    uid=$(stat -c %u "$home")
    groupadd --gid "$uid" "$1"
    useradd --uid "$uid" --gid "$uid" --home-dir "$home" --no-create-home \
      --shell /usr/bin/zsh "$1"
  else
    useradd --user-group --home-dir "$home" --no-create-home \
      --shell /usr/bin/zsh "$1"
    install -d -o "$1" -g "$1" -m 0700 "$home"
  fi
}

# create_accounts creates the accounts accounts file $1 names. Accounts with a
# home are created first, so a new account cannot take the uid an existing
# home belongs to.
create_accounts() {
  names=$(kuberex-accounts "$1")
  for name in $names; do
    if [ -d "/home/$name" ]; then
      create_account "$name"
    fi
  done
  for name in $names; do
    create_account "$name"
  done
}

# create_tmpdirs makes /tmp/user/<uid>, pam_tmpdir's TMPDIR, for every account
# accounts file $1 names. The login server runs PAM with the account's uid,
# which can create neither that directory nor the root-owned /tmp/user that
# pam_tmpdir requires above it.
create_tmpdirs() {
  install -d -o 0 -g 0 -m 0711 /tmp/user
  for name in $(kuberex-accounts "$1"); do
    install -d -o "$name" -g "$name" -m 0700 "/tmp/user/$(id -u "$name")"
  done
}

if [ "$(id -u)" != 0 ]; then
  echo "kuberex: the login server runs as root" >&2
  exit 1
fi
if [ -z "${REX_LOGIN_SERVER_ACCOUNTS:-}" ] || [ -z "${TS_SOCKET:-}" ]; then
  echo "kuberex: REX_LOGIN_SERVER_ACCOUNTS and TS_SOCKET are required" >&2
  exit 1
fi

if [ -n "${KUBEREX_APT:-}" ]; then
  install_packages "$KUBEREX_APT"
fi
create_accounts "$REX_LOGIN_SERVER_ACCOUNTS"
# Each account reaches its runtime directory below /run/rex.
chmod 0755 /run/rex
# The pod's fsGroup leaves an emptyDir /tmp at 2777 in that group, where any
# account may delete or replace another's files, /tmp/user included.
chown 0:0 /tmp
chmod 01777 /tmp
create_tmpdirs "$REX_LOGIN_SERVER_ACCOUNTS"
# In a subshell that exits at once, so dumb-init rather than the login server
# reaps kuberex-services and the account servers it starts.
if [ -n "${KUBEREX_SERVICES:-}" ]; then
  (kuberex-services "$KUBEREX_SERVICES" &)
fi

exec rex login-server \
  --accounts "$REX_LOGIN_SERVER_ACCOUNTS" \
  --runtime-root /run/rex \
  --extra-listen "tailnet://:${REX_TAILNET_PORT:-80}" \
  --tailscaled-socket "$TS_SOCKET" \
  --log-format text
